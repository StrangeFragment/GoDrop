{
  "id": "WIFI",
  "name": "Мониторинг Wi-Fi",
  "description": "Следит за качеством сигнала, SSID, скоростью линка и используемым каналом.",
  "exe_name": "wifi_loger.exe",
  "log_file": "wifi_records.jsonl",
  "has_charts": true,
  "view_type": "charts", 
  "ui_schema": [
    {
      "key": "interval_sec",
      "label": "Интервал опроса адаптера (сек)",
      "type": "number",
      "default": "5"
    },
    {
      "key": "min_signal_drop_dbm",
      "label": "Порог фиксации изменения сигнала (dBm)",
      "type": "number",
      "default": "5"
    },
    {
      "key": "max_log_mb",
      "label": "Максимальный размер лога (МБ)",
      "type": "number",
      "default": "5"
    }
  ]
}
