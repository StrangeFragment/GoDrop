+function toggleAutoPing(enabled) {
+    localStorage.setItem('wifi_auto_ping', enabled ? 'true' : 'false');
+    if (autoPingTimer) clearInterval(autoPingTimer);
+
+    if (enabled) {
+        checkGatewayPing();
+        autoPingTimer = setInterval(() => {
+            if (!document.hidden && !isPaused) {
+                checkGatewayPing();
+            }
